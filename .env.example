# Modèle du fichier .env : copier ce fichier en .env et remplacer les valeurs
# Générer les mots de passe et la clé avec : openssl rand -hex 24  (ou -hex 64 pour JWT_SECRET)

PORT=3000

# Connexion à MongoDB (l adresse complète est reconstruite par src/config/db.js)
MONGO_UTILISATEUR=reseau_api
MONGO_MOT_DE_PASSE=mot-de-passe-a-generer
# 127.0.0.1 pour lancer l API sur la machine. Docker Compose remplace cette valeur par "mongo"
MONGO_HOTE=127.0.0.1
MONGO_BASE=reseau_social

JWT_SECRET=changez-moi-par-une-longue-valeur-aleatoire

# Adresse du front-end autorisé à appeler l API (CORS)
CORS_ORIGINE=http://localhost:5500
