# Modèle du fichier .env.mongo : copier ce fichier en .env.mongo et remplacer le mot de passe
# Compte administrateur de MongoDB, créé au premier démarrage du conteneur
# Générer le mot de passe avec : openssl rand -hex 24
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mot-de-passe-a-generer
